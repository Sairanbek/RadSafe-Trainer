{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rst-backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "website/backend",
      "port": 8000
    },
    {
      "name": "rst-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "website/frontend",
      "url": "http://127.0.0.1:5173",
      "port": 5173
    },
    {
      "name": "rst-mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "mobile",
      "port": 8081
    }
  ]
}
