# Настройки продового развёртывания. Скопируйте в deploy/.env и заполните.
# Файл deploy/.env содержит секреты и в git не попадает (см. .gitignore).

# Домен, на котором будет работать сайт. DNS-запись A должна уже указывать на
# IP сервера — Caddy по этому имени сам получит сертификат Let's Encrypt.
# Для локальной проверки сборки без TLS поставьте :80 и открывайте http://IP.
SITE_ADDRESS=rst.example.kz

# Подпись JWT. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Смена значения мгновенно разлогинивает всех пользователей.
SECRET_KEY=

# Telegram-бот: токен от @BotFather и ваш Telegram ID для админских команд.
BOT_TOKEN=
ADMIN_ID=0

# Почта для подтверждения email и сброса пароля. Для Gmail нужен App Password
# (https://myaccount.google.com/apppasswords), не обычный пароль от аккаунта.
# Без этих переменных сайт работает, но письма отправляться не будут.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ИИ-ассистент и генерация дистракторов (Google AI Studio).
# Без ключа AI-эндпоинты возвращают ошибку, остальной сайт работает.
GEMINI_API_KEY=

# Дополнительные origin'ы для CORS через запятую. Сайт живёт на одном домене с
# API, поэтому ему CORS не нужен; заполняйте, только если мобильное приложение
# или другой клиент ходит с другого адреса.
# CORS_ORIGINS=https://rst.example.kz,https://app.example.kz
